{
  "mcpServers": {
    "vrcw": {
      "command": "node",
      "args": [
        "/absolute/path/to/VRChatWorldSDKAgentic/bundled/vrcw-mcp.mjs"
      ]
    },
    "unity-generic": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/absolute/path/to/VRChatWorldSDKAgentic/third_party/unity-mcp/Server",
        "--frozen",
        "--no-sync",
        "mcp-for-unity"
      ],
      "env": {
        "DISABLE_TELEMETRY": "1",
        "UNITY_MCP_DISABLE_TELEMETRY": "1",
        "MCP_DISABLE_TELEMETRY": "1"
      }
    }
  }
}
