node_modules/
dist/
dist-listing/
*.tsbuildinfo
obj/
bin/
.agentic/
*.log

# Unity writes .meta files into the bridge package when it is linked into a project.
# Our asmdef is referenced by name, not GUID, so these carry no information we need to track.
*.meta

# Vendored Unity packages reference assets by GUID, and those GUIDs live in the .meta files.
# Dropping them would break the package internally, so they are tracked here.
!third_party/**/*.meta

# Python build and environment artifacts, including the one `uv sync` creates inside the vendored server.
# The lockfile is tracked; what it resolves to is not.
__pycache__/
*.pyc
.venv/
*.egg-info/

# Machine-local configuration and credentials.
/.mcp.json
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
.npmrc
.pypirc

# Unity project caches and local editor settings.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]ser[Ss]ettings/
/[Bb]uild/
/[Bb]uilds/
.vs/
.idea/
.DS_Store
Thumbs.db
